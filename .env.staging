# FlexyRide Staging Environment Configuration
APP_ENV=staging
DEBUG=False
SECRET_KEY=your-staging-secret-key-change-this-in-production

# Important: Use the staging subdomains
ALLOWED_HOSTS=staging.api.flexyridegh.com,127.0.0.1,localhost

# Database - Pointing to the isolated staging database we defined in deploy_staging.sh
# Syntax: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://patmac:qwerty%asdf@127.0.0.1:5432/flexyride_staging_db

# Redis - Use different indexes (e.g. /3 and /4) so staging doesn't overwrite production cache
REDIS_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4

# RabbitMQ Broker for Celery
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//

# APIs (You can use test API keys here so you don't charge real cards)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.flexyridegh.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@flexyridegh.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=FlexyRide Staging <noreply@flexyridegh.com>
ADMIN_EMAIL=admin@flexyridegh.com
